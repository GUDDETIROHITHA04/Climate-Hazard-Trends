# development | production. In production MONGODB_URI is mandatory.
APP_ENV=development
# MongoDB Atlas connection string. Empty in development = in-memory mongomock.
MONGODB_URI=
MONGODB_DB=climate_hazards
# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
CACHE_TTL_DAYS=30
RATE_LIMIT=20/minute
LOG_LEVEL=INFO

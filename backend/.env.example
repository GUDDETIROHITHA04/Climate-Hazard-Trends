# development | production
APP_ENV=development
# MongoDB connection string. Leave empty to use process-local in-memory mongomock
# (temporary data; lost whenever the backend process restarts).
MONGODB_URI=
MONGODB_DB=climate_hazards
# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
CACHE_TTL_DAYS=30
RATE_LIMIT=20/minute
LOG_LEVEL=INFO
